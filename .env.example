# ── Google Gemini (항목 추출) — 무료 티어 ────────────────────
# https://aistudio.google.com/apikey 에서 무료로 발급
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# ── 로컬 Whisper (음성 → 텍스트) — 완전 무료, API 키 불필요 ──
# 모델 크기: tiny < base < small < medium < large-v3
#   클수록 정확하지만 느리고 메모리를 더 씁니다.
#   CPU만 있으면 small~medium, 좋은 GPU가 있으면 large-v3 권장.
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu          # GPU 사용 시 cuda
WHISPER_COMPUTE_TYPE=int8   # GPU(cuda) 사용 시 float16 권장

# ── 폴더 경로 (비워두면 기본값 사용) ──────────────────────────
INPUT_DIR=input
OUTPUT_DIR=output
