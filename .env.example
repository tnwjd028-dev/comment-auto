# ── Anthropic (항목 추출/정리) ─────────────────────────────
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Naver CLOVA Speech (음성 → 텍스트) ─────────────────────
# 네이버 클라우드 플랫폼 > CLOVA Speech > 도메인 생성 후 확인
#   - Invoke URL: 도메인 상세의 "Invoke URL" 전체 주소
#   - Secret Key: 도메인 상세의 "Secret Key"
CLOVA_SPEECH_INVOKE_URL=https://clovaspeech-gw.ncloud.com/external/v1/0000/xxxxxxxx
CLOVA_SPEECH_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── 폴더 경로 (상대/절대 경로 모두 가능, 비워두면 기본값 사용) ──
INPUT_DIR=input
OUTPUT_DIR=output

# 처리할 모델 (기본값 권장)
ANTHROPIC_MODEL=claude-opus-4-8
